        printf '  ║     📖  SAMBOX MANUAL & DOCUMENTAÇÃO     ║\n'
        printf '  ╚═══════════════════════════════════════════╝\n'
        printf "${RST}\n"
        printf "  ${BOLD}SELECIONE O CAPÍTULO PARA LEITURA:${RST}\n\n"
        printf "  ${CYAN}[1]${RST}  📜  Capítulo 1 — Filosofia, Licença BSD & Zero Copyleft\n"
        printf "  ${CYAN}[2]${RST}  ⚙️   Capítulo 2 — Guia Completo dos Módulos Integrados\n"
        printf "  ${CYAN}[3]${RST}  📚  Manual Completo (Modo Pager)\n"
        printf "  ${DIM}────────────────────────────────────────────────${RST}\n"
        printf "  ${CYAN}[0]${RST}  ⬅️   Voltar ao Menu Principal\n\n"

        read -rp "  $(printf "${BOLD}")Escolha [0-3]:$(printf "${RST}") " m_choice

        case "${m_choice}" in
            1)
                _pager_view "$(cat << EOF
${BOLD}${CYAN}=== CAPÍTULO 1: FILOSOFIA & GOVERNANÇA ===${RST}

${BOLD}1. Visão Geral:${RST}
O Sambox é uma caixa de ferramentas em Bash 4.0+ puro, ultra-leve e modular,
focada em desempenho máximo para distribuições Debian e derivados.

${BOLD}2. Licenciamento BSD 2-Clause (Permissivo):${RST}
- O código é 100% livre para uso, modificação e redistribuição sem travas.
- Imune a licenças copyleft virais.
- Projetado para auditoria simples e zero custos computacionais desnecessários.

${BOLD}3. Arquitetura Standalone:${RST}
- Pode rodar diretamente via terminal de qualquer pasta via symlink no PATH.
- Baixo consumo de memória e execução em milissegundos.

(Pressione 'q' para fechar)
EOF
)"
                ;;
            2)
                _pager_view "$(cat << EOF
${BOLD}${CYAN}=== CAPÍTULO 2: GUIA DOS MÓDULOS ===${RST}

${GREEN}[1] Hardware:${RST}   Diagnóstico térmico e monitoramento de performance da CPU.
${GREEN}[2] Uninstall:${RST}  Central de remoção limpa de softwares e pacotes órfãos.
${GREEN}[3] Network:${RST}    Gerenciador rápido de conexões SSH e diagnóstico de rede.
${GREEN}[4] Packages:${RST}   Controle do APT, manutenção de repositórios e drivers.
${GREEN}[5] System:${RST}     Engine Debian para purga de caches residuais e debloat.
${GREEN}[6] SysInfo:${RST}    Resumo sintético e auditoria do sistema host.

(Pressione 'q' para fechar)
EOF
)"
                ;;
            3)
                _pager_view "$(cat << EOF
${BOLD}${YELLOW}======================================================================
               🧰 SAMBOX v${SAMBOX_VERSION} — MANUAL DE INSTRUÇÕES
======================================================================${RST}

${BOLD}REQUISITOS:${RST} Bash 4.0+ em distribuições Linux POSIX/Debian.
${BOLD}LICENÇA:${RST}    BSD 2-Clause

${CYAN}EXECUÇÃO RÁPIDA (MODO CLI):${RST}
  sambox             Abre a TUI interativa do sistema
  sambox --manual    Abre o leitor de manual
  sambox --clean     Executa a limpeza profunda do sistema via CLI
  sambox --sysinfo   Exibe informações sintéticas do hardware/SO
  sambox --update    Atualiza os índices APT e executa safe-upgrade
  sambox --version   Exibe a versão instalada

(Pressione 'q' para fechar)
EOF
)"
                ;;
            0) break ;;
            *) _warn "Opção inválida." && sleep 1 ;;
        esac
    done
}

# ── Carregamento Dinâmico e Seguro de Módulos ──────────────────────────────
_load_modules() {
    if [[ ! -d "${MODULES_DIR}" ]]; then
        _err "Diretório de módulos não encontrado!"
        _err "Caminho procurado: ${MODULES_DIR}"
        exit 1
    fi

    local mod_count=0
    local mod
    for mod in "${MODULES_DIR}"/*.sh; do
        [[ -f "${mod}" ]] || continue
        # shellcheck source=/dev/null
        if source "${mod}"; then
            mod_count=$(( mod_count + 1 ))
        else
            _err "Falha crítica ao carregar o módulo: ${mod}"
            exit 1
        fi
    done

    if [[ "${mod_count}" -eq 0 ]]; then
        _warn "Nenhum módulo .sh foi encontrado em ${MODULES_DIR}."
    fi
}

# ── Fallback Seguro para Chamadas de Módulos Opcionais ──────────────────────
_dispatch() {
    local func_name="$1"
    local fallback_msg="$2"

    if declare -f "${func_name}" >/dev/null; then
        "${func_name}"
    else
        _err "Módulo não carregado ou função ausente: [${func_name}]"
        _warn "${fallback_msg}"
    fi
}

# ── Help / Uso do Utilitário CLI ───────────────────────────────────────────
_show_help() {
    echo "Sambox Engine v${SAMBOX_VERSION} — Toolbox de Administração"
    echo "Uso: $0 [opção]"
    echo ""
    echo "Opções disponíveis:"
    echo "  --manual        Abre o leitor interativo de instruções"
    echo "  --clean         Executa diretamente a limpeza profunda de sistema (purge_system_bloat)"
    echo "  --sysinfo       Exibe a síntese de especificações de hardware e SO"
    echo "  --update        Executa a atualização de repositórios e pacotes APT"
    echo "  --version, -v   Exibe a versão do Sambox"
    echo "  --help, -h      Exibe este menu de ajuda"
}

# ── Menu Principal TUI ─────────────────────────────────────────────────────
_main_menu() {
    local choice
    while true; do
        _banner
        printf "  ${BOLD}MÓDULOS DISPONÍVEIS${RST}\n\n"
        printf "  ${CYAN}[1]${RST}  🔧  Hardware  — CPU Performance & Diagnostics\n"
        printf "  ${CYAN}[2]${RST}  🗑️   Uninstall — Central de Remoção & Limpeza Profunda\n"
        printf "  ${CYAN}[3]${RST}  🌐  Network   — SSH Fast Connect Manager & Network Drivers\n"
        printf "  ${CYAN}[4]${RST}  📦  Packages  — APT Control, Drivers & Desktops\n"
        printf "  ${CYAN}[5]${RST}  🧹  System    — Purge System Bloat (Debian Engine)\n"
        printf "  ${CYAN}[6]${RST}  ❓  SysInfo   — Concise System Overview & Diagnostics\n"
        printf "  ${CYAN}[7]${RST}  📖  Manual    — Leitor Interativo de Instruções\n"
        printf "  ${DIM}────────────────────────────────────────────────${RST}\n"
        printf "  ${CYAN}[0]${RST}  ❌  Sair\n\n"

        read -rp "  $(printf "${BOLD}")Selecione [0-7]:$(printf "${RST}") " choice

        case "${choice}" in
            1) _dispatch "menu_hardware_central" "Módulo de Hardware (m_hardware.sh) indisponível." ;;
            2) _dispatch "menu_uninstall_central" "Módulo de Desinstalação (m_uninstaller.sh) indisponível." ;;
            3) _dispatch "ssh_fast_connect"       "Módulo de Rede (m_network.sh) indisponível." ;;
            4) _dispatch "menu_packages_central"  "Módulo de Pacotes (m_packages.sh) indisponível." ;;
            5) _dispatch "menu_system_central"    "Módulo de Manutenção (m_system.sh) indisponível." ;;
            6) _dispatch "show_system_info"       "Módulo SysInfo (m_sysinfo.sh) indisponível." ;;
            7) _show_manual ;;
            0) printf "\n"; _msg "Saindo do Sambox. Até logo!"; exit 0 ;;
            *) _warn "Opção inválida. Tente novamente." ;;
        esac

        printf "\n"
        read -rp "  Pressione [ENTER] para voltar ao menu..." _
        clear 2>/dev/null || true
    done
}

# ── Ponto de Entrada do Motor (Main Execution) ─────────────────────────────
_main() {
    _load_modules

    # Tratamento de Argumentos CLI
    if [[ $# -gt 0 ]]; then
        case "$1" in
            --manual)
                _show_manual
                exit 0
                ;;
            --clean)
                _dispatch "purge_system_bloat" "Não foi possível executar a limpeza."
                exit 0
                ;;
            --sysinfo)
                _dispatch "show_system_info" "Não foi possível exibir informações do sistema."
                exit 0
                ;;
            --update)
                _dispatch "update_system_packages" "Não foi possível atualizar o sistema."
                exit 0
                ;;
            --version|-v)
                echo "Sambox Engine v${SAMBOX_VERSION}"
                exit 0
                ;;
            --help|-h)
                _show_help
                exit 0
                ;;
            *)
                _err "Argumento desconhecido: $1"
                _show_help
                exit 1
                ;;
        esac
    fi

    # Inicia a TUI interativa caso nenhum argumento CLI tenha sido informado
    clear 2>/dev/null || true
    _main_menu
}

# Dispara a execução repassando os parâmetros de terminal
_main "$@"
