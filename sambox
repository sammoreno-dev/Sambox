set -euo pipefail

# ── Ajuste de PATH para Utilitários de Sistema (/sbin, /usr/sbin) ───────────
export PATH="${PATH}:/sbin:/usr/sbin:/usr/local/sbin"

# 1. Resolução Absoluta de Diretório Real (Suporte Total a Symlinks no $PATH) ─
_resolve_sambox_dir() {
    local src="${BASH_SOURCE[0]}"
    local dir=""
    while [[ -L "${src}" ]]; do
        dir="$(cd -P "$(dirname "${src}")" >/dev/null 2>&1 && pwd)"
        src="$(readlink "${src}")"
        [[ ${src} != /* ]] && src="${dir}/${src}"
    done
    cd -P "$(dirname "${src}")" >/dev/null 2>&1 && pwd
}

export BASE_DIR="$(_resolve_sambox_dir)"
export MODULES_DIR="${BASE_DIR}/modules"

# Paleta ANSI Padrão Corporativa (Mantendo Uniformidade Visual com Sambox 2)
export RST='\033[0m' BOLD='\033[1m' DIM='\033[2m'
export RED='\033[31m' GREEN='\033[32m' YELLOW='\033[33m' CYAN='\033[36m'

# 2. Infraestrutura de Auto-Registro Dinâmico (Filosofia Sambox 2)
declare -g -a SAMBOX_MODULE_NAMES=()
declare -g -a SAMBOX_MODULE_FUNCS=()

register_sambox_module() {
    SAMBOX_MODULE_NAMES+=("$1")
    SAMBOX_MODULE_FUNCS+=("$2")
}

# 3. Função de Hot-Reload (Carregamento Inteligente e Limpeza de Estado)
reload_sambox_modules() {
    SAMBOX_MODULE_NAMES=()
    SAMBOX_MODULE_FUNCS=()
    if [[ -d "${MODULES_DIR}" ]]; then
        for module in "${MODULES_DIR}"/m_*.sh; do
            local mod_name="${module##*/}"
            # Ignora o arquivo de menu principal na injeção automática para não quebrar a TUI
            [[ -f "${module}" && "${mod_name}" != "m_mainmenu.sh" ]] && source "${module}"
        done
    fi
}

# Realiza a primeira varredura de ambiente na inicialização
reload_sambox_modules

# 4. Helpers Visuais Globais da Interface (UI) e Sinais
_msg()  { printf "  ${GREEN}[✓]${RST} %s\n" "$1"; }
_warn() { printf "  ${YELLOW}[!]${RST} %s\n" "$1"; }
_err()  { printf "  ${RED}[✗]${RST} %s\n" "$1"; return 1; }
_sep()  { printf "  ${DIM}────────────────────────────────────────────────${RST}\n"; }

_cleanup() {
    tput cnorm 2>/dev/null || true
    printf "${RST}\n  ${YELLOW}[!]${RST} Execução interrompida pelo usuário. Saindo do Sambox...\n"
    exit 130
}
trap _cleanup SIGINT SIGTERM

# Exibição Inteligente em Pager (Preservada da sua versão original)
_pager_view() {
    local content="$1"
    if command -v less &>/dev/null; then
        printf "%s" "${content}" | less -R
    elif command -v more &>/dev/null; then
        printf "%s" "${content}" | more
    else
        printf "%s" "${content}"
    fi
}

# Garante o carregamento do menu principal agnóstico estritamente por último
[[ -f "${MODULES_DIR}/m_mainmenu.sh" ]] && source "${MODULES_DIR}/m_mainmenu.sh"

# 5. Despachante Avançado de Parâmetros (CLI) ou Inicialização da TUI
_main() {
    if [[ $# -gt 0 ]]; then
        case "${1}" in
            --packages|-p) shift; declare -f run_packages_cli >/dev/null && run_packages_cli "$@" || _err "Módulo CLI ausente." ;;
            --sysinfo|-s)  shift; declare -f run_sysinfo_cli  >/dev/null && run_sysinfo_cli  "$@" || _err "Módulo CLI ausente." ;;
            --security|-x) shift; declare -f run_security_cli >/dev/null && run_security_cli "$@" || _err "Módulo CLI ausente." ;;
            --help|-h)
                echo "Uso: $(basename "$0") [FLAGS] ou execute sem argumentos para TUI."
                echo "Flags Admin: --packages, --sysinfo, --security"
                ;;
            *) _err "Parâmetro desconhecido. Use -h para ajuda." ;;
         Duned) esac
    else
        # Se invocado sem argumentos na CLI, dispara a TUI dinâmica
        if declare -f menu_principal_tui >/dev/null 2>&1; then
            menu_principal_tui
        else
            _err "Interface Visual (m_mainmenu.sh) indisponível."
        fi
    fi
}

# Dispara o ciclo de vida da aplicação
_main "$@"

